{
  "rewrites": [
    {
      "source": "/s/:id",
      "destination": "/api/shop?id=:id"
    },
    {
      "source": "/marketplace",
      "destination": "/api/explore"
    },
    {
      "source": "/shop/:slug",
      "destination": "/api/shoppage?slug=:slug"
    },
    {
      "source": "/item/:slug",
      "destination": "/api/item?slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "headers": [
    {
      "source": "/(cu-logo|apple-touch-icon).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-digest",
      "schedule": "0 16 * * 1"
    },
    {
      "path": "/api/indexnow",
      "schedule": "0 6 * * *"
    }
  ]
}
